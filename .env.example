# Visual Crossing Weather API key
API_KEY=<your-visual-crossing-api-key>

# Flask session secret
FLASK_SECRET_KEY=<random-secret>

# Firebase Admin SDK (download the service-account JSON yourself; never commit it)
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-adminsdk.json
FIREBASE_DATABASE_URL=https://<your-project-id>-default-rtdb.firebaseio.com

# Contact form (Gmail address + app password used to send messages)
CONTACT_RECEIVER_EMAIL=<you@example.com>
CONTACT_EMAIL_APP_PASSWORD=<gmail-app-password>
